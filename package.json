{
  "name": "@vasugrover/bun-bkp",
  "type": "module",
  "version": "1.0.0",
  "private": false,
  "description": "Modular backup and restore service for Bun applications with Cloudflare R2 storage integration, database adapters, and scheduled backup support",
  "license": "MIT",
  "homepage": "https://github.com/itsvasugrover/bun-bkp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsvasugrover/bun-bkp.git"
  },
  "bugs": {
    "url": "https://github.com/itsvasugrover/bun-bkp/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "backup",
    "restore",
    "database",
    "r2",
    "cloudflare",
    "storage",
    "drizzle",
    "backup-service",
    "disaster-recovery",
    "bun"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "module": "src/index.ts",
  "types": "src/index.ts",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "lint": "bunx biome lint .",
    "format": "bunx biome format --write .",
    "check": "bunx biome check --write .",
    "ci:check": "bunx biome ci .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "pino": "^10.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.0",
    "@types/bun": "latest",
    "@vasugrover/biome-config": "^1.0.0",
    "@vasugrover/typescript-config": "^1.0.0"
  }
}
